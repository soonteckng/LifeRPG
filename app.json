{
  "expo": {
    "name": "LifeRPG",
    "slug": "LifeRPG",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "liferpg",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080809",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1030d96a-3a08-4d88-91cc-51c892688fea"
    },
    "ios": {
      "bundleIdentifier": "com.soonteck.liferpg",
      "icon": "./assets/expo.icon",
      "backgroundColor": "#080809"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "backgroundColor": "#080809",
      "adaptiveIcon": {
        "backgroundColor": "#080809",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.soonteck.liferpg",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080809",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D9C6A3",
          "allowSchedulesExactAlarm": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1030d96a-3a08-4d88-91cc-51c892688fea"
      }
    },
    "owner": "soonteck"
  }
}
